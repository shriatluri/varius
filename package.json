{
  "name": "varius-fleet",
  "version": "0.1.0",
  "private": true,
  "description": "Personal fleet of Claude Code agents on a single VPS",
  "scripts": {
    "post": "tsx src/cli.ts post",
    "agent": "tsx src/cli.ts agent",
    "bridge": "tsx src/bridge.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit && npm test && for f in scripts/*.sh; do bash -n \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@slack/bolt": "^4",
    "@slack/web-api": "^7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  }
}
