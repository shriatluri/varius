# /etc/systemd/system/fleet-watchdog.service — oneshot, fired by the timer.
# Runs as root: it must read the journal and restart fleet-bridge. So it runs
# a root-owned copy, never the fleet-writable /srv/fleet/scripts/watchdog.sh.
[Unit]
Description=Fleet bridge watchdog (restart on zombie Socket Mode connection)

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet-watchdog
