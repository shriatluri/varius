# Copy to .env on the VPS, chmod 600, owned by fleet. Never commit .env.

# claude setup-token (run interactively as fleet)
CLAUDE_CODE_OAUTH_TOKEN=

# Slack app — Socket Mode
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Channel ID for failure alerts (#ag-ops)
OPS_CHANNEL=

# Only this Slack user may click Merge/Deny (unset = anyone in the channel)
OPERATOR_USER=

# Voice mode (scripts/jarvis.py) — local Mac only, see docs/VOICE.md.
# No accounts/keys: openWakeWord pretrained name, or path to a custom .onnx
# (e.g. scripts/varius.onnx).
JARVIS_WAKEWORD=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_DEFAULT_AGENT=research
JARVIS_WHISPER_MODEL=base.en
# Optional: cap how long jarvis waits for a reply (seconds); default = agent timeout
JARVIS_REPLY_TIMEOUT=
