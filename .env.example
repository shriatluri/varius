# Copy to .env on the VPS, chmod 600, owned by fleet. Never commit .env.

# claude setup-token (run interactively as fleet)
CLAUDE_CODE_OAUTH_TOKEN=

# Slack app — Socket Mode
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Channel ID for failure alerts (#ag-ops)
OPS_CHANNEL=

# Slack user ID (U…) allowed to click Merge/Deny. Required for the buttons
# to do anything — unset means nobody can merge, not everybody.
OPERATOR_USER=
