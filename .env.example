# Copy to .env on the VPS, chmod 600, owned by fleet. Never commit .env.

# claude setup-token (run interactively as fleet)
CLAUDE_CODE_OAUTH_TOKEN=

# Slack app — Socket Mode
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Channel ID for failure alerts (#ops)
OPS_CHANNEL=

# Only this Slack user may click Merge/Deny (unset = anyone in the channel)
OPERATOR_USER=

# Erica agent (agents/erica/mail.sh) — Gmail SMTP with an app password.
# MAIL_FROM is the Gmail account the daily email is sent from; it needs
# 2-Step Verification, then create a 16-char app password at
# myaccount.google.com/apppasswords. MAIL_TO is the fixed recipient: the agent
# cannot address anyone else.
MAIL_FROM=
MAIL_APP_PASSWORD=
MAIL_TO=

# Strava (health agent, scripts/strava-link.mjs). Read-only: activity:read_all.
# The Strava MCP can't be used: claude -p never refreshes MCP OAuth tokens, so
# it dies within ~6h on an unattended box. agents/health/strava.sh does the
# refresh-token grant itself instead. Create an API app at
# strava.com/settings/api (Authorization Callback Domain = localhost) for the
# client id/secret; REFRESH_TOKEN comes from the one-time Link flow, not the
# dashboard (the dashboard token lacks the activity:read_all scope).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
