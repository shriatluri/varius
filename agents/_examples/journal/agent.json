{
  "id": "journal",
  "name": "Journal",
  "channel": "C_REPLACE_ME",
  "model": "sonnet",
  "interactive": true,
  "allowedTools": ["Read", "Write", "Edit"],
  "maxTurns": 30,
  "timeoutSec": 900,
  "context": {
    "read": ["self"],
    "write": ["self"],
    "budget": { "tokens": 2000 }
  },
  "schedule": {
    "prompt": "prompts/morning.md",
    "onCalendar": "*-*-* 07:00:00"
  }
}
